install-info: install-info-am

install-info-am:

install-man:

install-pdf: install-pdf-am

install-pdf-am:

install-ps: install-ps-am

install-ps-am:

installcheck-am:

maintainer-clean: maintainer-clean-am
	-rm -f ./$(DEPDIR)/gphoto-camera.Po
	-rm -f ./$(DEPDIR)/gphoto-cli.Po
	-rm -f ./$(DEPDIR)/gphoto-config-dialog.Po
	-rm -f ./$(DEPDIR)/gphoto-gui.Po
	-rm -f ./$(DEPDIR)/gphoto-html.Po
	-rm -f ./$(DEPDIR)/gphoto-main.Po
	-rm -f ./$(DEPDIR)/gphoto-viewer.Po
